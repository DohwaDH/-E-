```mermaid
graph TB
    %% UI 패키지
    subgraph UI_Package [App and UI Components]
        App[OrdealDungeonApp]
        GameScr[GameScreen]
        SkinShopScr[SkinShopScreen]
    end

    %% 게임 코어 로직 패키지
    subgraph Core_Package [Game Core Data]
        WeaponData[Weapon and Armor Pool]
        FloorData[Floor and Enemy Data]
        SkillData[Skill Info]
    end

    %% 외부 연동 및 유틸리티 패키지
    subgraph System_Package [System Utilities]
        SaveSys[Save and Option System]
        BitsMgr[Bits and Ether Manager]
        SkinMgr[Skin Manager]
    end

    %% 플랫폼 의존 패키지 (모바일용)
    subgraph Mobile_Package [Mobile Platforms]
        AdSys[Admob Ad System]
        GoogleAuth[Google Auth System]
    end

    %% 네이티브 안드로이드
    subgraph Android_Native [Android OS Native and Java]
        J_Bridge["RewardedBridge / GoogleLogin Java"]
    end

    %% 패키지 및 모듈 간 의존성 관계
    UI_Package --> Core_Package
    UI_Package --> System_Package
    UI_Package --> Mobile_Package
    Mobile_Package --> System_Package
    Mobile_Package ..> Android_Native
```
